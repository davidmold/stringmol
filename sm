#!/usr/bin/env bash
# Operator wrapper for Stringmol runs (one detached container per run).
#   ./sm build                      build the image
#   ./sm start NAME CONF            copy CONF to runs/NAME/run.conf and start a run
#   ./sm status                     list runs and their latest step
#   ./sm logs NAME                  tail a run's output
#   ./sm stop NAME                  stop a run (output is kept)
#   ./sm bind PAIRS                 binding probabilities + copier role for molecule pairs
#   ./sm react PAIRS [MAXSTEPS]     run each pairwise reaction to completion (mutation off)
#   ./sm resume NAME FROM STEP      continue run FROM from its checkpoint at STEP as new run NAME
#   ./sm batch LIST [N]             run every "NAME CONF" line in LIST, at most N at once (default 5);
#                                   runs in the background, log in runs/batch.log
#   ./sm viz NAME [EVERY]           build runs/NAME/viewer.html (open in a browser)
# PAIRS file lines: "R name seq" (replicase) or "P name seq" (other)
set -euo pipefail
cd "$(dirname "$0")"
RUNS="$PWD/runs"

case "${1:-}" in
  build)
    docker compose build ;;
  start)
    name="${2:?run name}"; conf="${3:?config file}"
    [ -f "$conf" ] || { echo "no such config: $conf" >&2; exit 1; }
    [ -e "$RUNS/$name" ] && { echo "run '$name' already exists in $RUNS" >&2; exit 1; }
    mkdir -p "$RUNS/$name"
    cp "$conf" "$RUNS/$name/run.conf"
    docker compose run -d --name "stringmol-$name" -v "$RUNS/$name:/runs" smspatial run.conf >/dev/null
    echo "started stringmol-$name -> $RUNS/$name" ;;
  status)
    for d in "$RUNS"/*/; do
      [ -d "$d" ] || continue
      n=$(basename "$d")
      st=$(docker inspect -f '{{.State.Status}}' "stringmol-$n" 2>/dev/null || echo "gone")
      # container stdout is block-buffered, so read progress from the population file instead
      # last complete step: the newest group may still be being written, so report the one before it
      last=$(tail -c 8000000 "$d/popdy001.dat" 2>/dev/null | awk -F, 'NF==3{if($1!=t){pt=t;pn=n;t=$1;n=0} n+=$3} END{if(pt!="") printf "step %d, %d molecules", pt, pn}')
      grep -q EXTINCT <(docker logs "stringmol-$n" 2>/dev/null) && last="$last (extinct)"
      printf '%-24s %-8s %s\n' "$n" "$st" "${last:-}"
    done ;;
  logs)
    docker logs --tail 20 -f "stringmol-${2:?run name}" ;;
  stop)
    docker stop "stringmol-${2:?run name}" ;;
  resume)
    name="${2:?new run name}"; from="${3:?source run}"; step="${4:?checkpoint step}"
    src="$RUNS/$from"; c=$(printf '%s/out1_%05d.conf' "$src" "$step")
    [ -f "$c" ] && [ -f "$src/RNGstate_$step.txt" ] || { echo "no checkpoint $step in $from" >&2; exit 1; }
    [ -e "$RUNS/$name" ] && { echo "run '$name' already exists" >&2; exit 1; }
    mkdir -p "$RUNS/$name"; cp "$c" "$RUNS/$name/run.conf"; cp "$src/RNGstate_$step.txt" "$RUNS/$name/"
    docker compose run -d --name "stringmol-$name" -v "$RUNS/$name:/runs" smspatial run.conf >/dev/null
    echo "resumed $from@$step as stringmol-$name" ;;
  batch)
    list="${2:?list file}"; max="${3:-5}"; [ -f "$list" ] || { echo "no such file: $list" >&2; exit 1; }
    list=$(realpath "$list"); me=$(realpath "$0")
    nohup bash -c '
      list="$1"; max="$2"; me="$3"; runs="$4"
      while read -r name conf; do
        [ -z "$name" ] && continue
        [ -e "$runs/$name" ] && { echo "$(date -Is) skip $name (exists)"; continue; }
        while [ "$(docker ps --filter name=^stringmol- --format x | wc -l)" -ge "$max" ]; do sleep 60; done
        echo "$(date -Is) start $name"; "$me" start "$name" "$conf" >/dev/null 2>&1
        sleep 5
      done < "$list"
      echo "$(date -Is) batch done"' _ "$list" "$max" "$me" "$RUNS" >> "$RUNS/batch.log" 2>&1 &
    echo "batch started from $list (max $max at once); log: $RUNS/batch.log" ;;
  viz)
    name="${2:?run name}"; [ -d "$RUNS/$name" ] || { echo "no run '$name'" >&2; exit 1; }
    python3 viz/build.py "$RUNS/$name" "$RUNS/$name/viewer.html" "${3:-500}" ;;
  bind|react)
    f="${2:?pairs file}"; [ -f "$f" ] || { echo "no such file: $f" >&2; exit 1; }
    tool=sm-bind; [ "$1" = react ] && tool=sm-react
    docker compose run --rm -T --entrypoint "$tool" -v "$(realpath "$f"):/pairs.txt:ro" smspatial \
      /opt/stringmol/config/spatial_stringmol_v2.0.3.conf /pairs.txt ${3:-} 2>&1 \
      | grep -v -e '^Reverting' -e '^Number of agents' -e '^No MIS' -e '^File name' -e '^$' ;;
  *)
    sed -n 2,15p "$0"; exit 1 ;;
esac
